ENVIRONMENT=development
TZ=Asia/Shanghai
DATABASE_URL=sqlite:///./backend/data/openslt.sqlite3
#DATABASE_URL=mysql+pymysql://username:password@ip:3306/openslt
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
# Leave empty to generate and persist a key under the data secrets directory.
# Or generate explicitly with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
ARTIFACT_ROOT=./backend/data/artifacts
KNOWLEDGE_ROOT=./backend/data/knowledge
LOG_DIR=./backend/logs
LOG_LEVEL=INFO
APP_LOG_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365
OBSERVABILITY_BODY_LIMIT_BYTES=65536
OBSERVABILITY_SQL_LIMIT_BYTES=32768
OBSERVABILITY_SQL_PARAMS_LIMIT_BYTES=8192
OBSERVABILITY_QUEUE_SIZE=10000
OBSERVABILITY_HOT_RETENTION_DAYS=30
OBSERVABILITY_ARCHIVE_RETENTION_DAYS=90
ENABLE_INTERNAL_SCHEDULER=true
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=shengli123
# Chat uses the user's personal model, falling back to the active chat model.
CHAT_MAX_CONCURRENT=4
CHAT_TIMEOUT_SECONDS=180
CHAT_MAX_TOKENS=2048
CHAT_CONTEXT_CHARS=24000
# Calibrate against real questions when changing the embedding model.
CHAT_MIN_VECTOR_SCORE=0.35
