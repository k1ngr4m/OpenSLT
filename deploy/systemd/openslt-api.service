[Unit]
Description=OpenSLT FastAPI service
After=network.target mariadb.service mysqld.service
[Service]
Type=simple
User=openslt
Group=openslt
WorkingDirectory=/opt/openslt
EnvironmentFile=/etc/openslt/openslt.env
Environment=ENVIRONMENT=production
Environment=TZ=Asia/Shanghai
Environment=ARTIFACT_ROOT=/var/lib/openslt/artifacts
Environment=LOG_DIR=/var/log/openslt
Environment=LOG_LEVEL=INFO
Environment=APP_LOG_RETENTION_DAYS=90
Environment=AUDIT_LOG_RETENTION_DAYS=365
Environment=OBSERVABILITY_BODY_LIMIT_BYTES=65536
Environment=OBSERVABILITY_QUEUE_SIZE=10000
Environment=OBSERVABILITY_HOT_RETENTION_DAYS=30
Environment=OBSERVABILITY_ARCHIVE_RETENTION_DAYS=90
Environment=ENABLE_INTERNAL_SCHEDULER=true
ExecStart=/opt/openslt/.venv/bin/uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 4396
Restart=on-failure
PrivateTmp=true
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
