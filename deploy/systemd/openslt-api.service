[Unit]
Description=OpenSLT FastAPI service
After=network.target mariadb.service mysqld.service
[Service]
Type=simple
User=openslt
Group=openslt
WorkingDirectory=/opt/openslt
EnvironmentFile=/etc/openslt/openslt.env
Environment=TZ=Asia/Shanghai
ExecStart=/opt/openslt/.venv/bin/uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 4396
Restart=on-failure
PrivateTmp=true
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
